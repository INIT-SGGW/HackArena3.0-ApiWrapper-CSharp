<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	<Protobuf Include="HackArena3.0-Proto\proto\**\*.proto" ProtoRoot="HackArena3.0-Proto\proto" GrpcServices="Client" OutputDir="..\src\HackArena3\Proto" CompileOutputs="false" Access="Public" />
	<Protobuf Include="HackArena-Proto\proto\hackarena\**\*.proto" ProtoRoot="HackArena-Proto\proto" GrpcServices="Client" OutputDir="..\src\HackArena3\Proto" CompileOutputs="false" Access="Public" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.78.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
